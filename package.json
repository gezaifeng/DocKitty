{
  "name": "word-git",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "e2e": "playwright test",
    "build:desktop": "pnpm --filter @wordgit/desktop build",
    "package:installer": "pnpm run build:desktop && node scripts/package-installer.mjs",
    "package:desktop": "pnpm run build:desktop && node scripts/package-desktop.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0"
  }
}
